Cell["Importing data and functions", "Section",
 CellChangeTimes->{{3.995320581854726*^9, 
  3.9953206062054033`*^9}},ExpressionUUID->"bfbbd696-380a-4623-a18b-\
7a6842689d19"],

Cell["\<\
TimeImpacts imports results of 1000 impacts on brachiating gait family under \
time-based switching. StateImpacts imports the same, under state-based \
switching. BUone is the initial brachiating gait family, containing \
time-based switching eigenvalues. StateBUone contains the same, under \
state-based switching. Indices corresponding to changes in stability are \
defined for time-based and state-based switching. \
\>", "Text",
 CellChangeTimes->{{3.995320611216075*^9, 3.995320637485475*^9}, {
  3.995320667847728*^9, 
  3.995320942777844*^9}},ExpressionUUID->"949f3f3f-56f6-4804-845a-\
d20264fc295a"],

