Cell["\<\
Plotting eigenvalues during period-doubling bifurcation of the brachiating \
gait family under state-based switching.\
\>", "Text",
 CellChangeTimes->{{3.99532010640901*^9, 
  3.995320131702073*^9}},ExpressionUUID->"5b04806b-f0ba-4e00-b5dc-\
684865af0888"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenVals", "=", 
   RowBox[{"StateBUone", "[", 
    RowBox[{"[", 
     RowBox[{"lastStableIdxState", ",", "3", ",", 
      RowBox[{"1", ";;", "4"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eigenPts", "=", 
    RowBox[{"ReIm", "/@", "eigenVals"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prBound", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xlab", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{"\"\<\\\\text{Im}(\\\\lambda)\>\"", ",", 
     RowBox[{"FontSize", "->", "36"}]}], "]"}]}], ";"}], "\n", 
