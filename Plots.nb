Cell[CellGroupData[{

Cell["Figure 2 Left Subfigure", "Section",
 CellChangeTimes->{{3.9919165148583937`*^9, 3.991916564962619*^9}, {
  3.995318618133539*^9, 
  3.9953186223187323`*^9}},ExpressionUUID->"5e52546a-b39e-4a7e-b512-\
d1f2edeb5a6e"],

Cell["\<\
Plots two symmetric gait families projected onto the q1(0)-q2(0) plane under \
time-based switching. Plots unstable gaits in red and stable gaits in blue. \
Arrows show evolution of select gaits, converging onto the mirrored family. \
Bifurcation points are labeled one gait family. The seed value used to \
generate the gait family is visualized in the bottom right corner of the \
plot. A figure of the two link model is imported and displayed in the upper \
left corner of the plot.\
\>", "Text",
 CellChangeTimes->{{3.995318631763723*^9, 3.995318833752672*^9}, {
  3.995318883935677*^9, 3.995318908234619*^9}, {3.9953190054682407`*^9, 
  3.995319045349434*^9}},ExpressionUUID->"c256975c-bb65-494a-8e7f-\
f1a0f61636e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"negatedBranches", "=", 
   RowBox[{"MapAt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "#"}], "&"}], ",", "BUone", ",", 
     RowBox[{"{", 
      RowBox[{"All", ",", "1", ",", 
       RowBox[{"1", ";;", "4"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"combinedData", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"BUone", ",", "negatedBranches"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stablePoints", "=", 
