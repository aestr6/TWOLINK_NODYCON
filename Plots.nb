Cell[CellGroupData[{

Cell["Figure 5", "Section",
 CellChangeTimes->{{3.991919060206139*^9, 3.991919064334817*^9}, {
  3.9953201544532757`*^9, 
  3.995320155680881*^9}},ExpressionUUID->"eba9a383-a8a9-495c-b83c-\
db9e61a1309d"],

Cell["\<\
Initial gaits for time-based brachiating gait family and its mirrored \
counterpart are plotted in light colors, red being unstable and blue being \
stable. Select initial gaits are shown as red points. The convergence of \
these initial gaits are plotted as cyan points. Arrows connect a few initial \
and convergent gaits.\
\>", "Text",
 CellChangeTimes->{{3.995320182040156*^9, 3.995320240619773*^9}, {
  3.995320308588385*^9, 3.995320344487471*^9}, {3.995320437478084*^9, 
  3.9953205214689627`*^9}},ExpressionUUID->"b9375dcf-f9ab-47fe-8785-\
ee4687855f65"],

