Cell[CellGroupData[{

Cell["Figure 5 Lower Right Subfigure", "Section",
 CellChangeTimes->{{3.9919165148583937`*^9, 3.991916564962619*^9}, {
  3.995318618133539*^9, 3.9953186223187323`*^9}, {3.9953190864152184`*^9, 
  3.995319094667454*^9}, {3.995319659358362*^9, 
  3.9953196679291267`*^9}},ExpressionUUID->"fd93d5b3-d183-446b-9eb2-\
51084d7b0bb7"],

Cell["\<\
Depicts the evolution of an unstable initial gait(red point) during \
Neimark-Sacker bifurcation. Closed invariant curve is plotted on q1-q2 plane. \
First 520 gaits are plotted in purple.  \
\>", "Text",
 CellChangeTimes->{{3.995319682472208*^9, 
  3.995319820009432*^9}},ExpressionUUID->"e167b9cb-e9c6-441e-bb82-\
1e5f74eeda8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"idx", "=", "7509"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringPts", "=", 
   RowBox[{
    RowBox[{"TimeImpacts", "[", 
     RowBox[{"[", 
      RowBox[{"idx", ",", 
       RowBox[{
        RowBox[{"-", "300"}], ";;"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "*", "radToDeg"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"cx", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"ringPts", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cy", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"ringPts", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sortedRingPts", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{"ringPts", ",", 
     RowBox[{
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "cx"}], ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", "cy"}]}], "]"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"closedRingPts", "=", 
   RowBox[{"Append", "[", 
    RowBox[{"sortedRingPts", ",", 
     RowBox[{"First", "[", "sortedRingPts", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeLine", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Thick", ",", 
       RowBox[{"Line", "[", "closedRingPts", "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"initialPtPlot", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TimeImpacts", "[", 
        RowBox[{"[", 
         RowBox[{"idxSection", ",", "1", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "*", "radToDeg"}], 
      "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sequencePtsPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"TimeImpacts", "[", 
        RowBox[{"[", 
         RowBox[{"idxSection", ",", 
          RowBox[{"1", ";;", "520"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "*", "radToDeg"}], 
      ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Purple", ",", 
         RowBox[{"PointSize", "[", "0.006", "]"}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"xlab", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{"\"\<q_1\>\"", ",", 
     RowBox[{"FontSize", "->", "36"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ylab", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{"\"\<q_2\>\"", ",", 
     RowBox[{"FontSize", "->", "36"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xticks", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"MaTeX", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<^\\\\circ\>\""}], ",", 
         RowBox[{"FontSize", "->", "24"}]}], "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "20"}], ",", "80", ",", "15"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yticks", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#", ",", 
        RowBox[{"MaTeX", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<^\\\\circ\>\""}], ",", 
          RowBox[{"FontSize", "->", "24"}]}], "]"}]}], "}"}], "&"}], "/@", 
     RowBox[{"Range", "[", 
      RowBox[{"100", ",", "180", ",", "10"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"sequencePtsPlot", ",", "edgeLine", ",", "initialPtPlot", ",", 
   RowBox[{"Background", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "650"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10"}], ",", "55"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"120", ",", "150"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"yticks", ",", "None"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"xticks", ",", "None"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"xlab", ",", "ylab"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.993666392377429*^9, 3.993666438876328*^9}, 
   3.99366893307598*^9},ExpressionUUID->"a8703a48-6e19-45eb-9f4a-\
