Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenVals", "=", 
   RowBox[{"BUone", "[", 
    RowBox[{"[", 
     RowBox[{"firstStableIdxTime", ",", "3", ",", 
      RowBox[{"1", ";;", "4"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eigenPts", "=", 
    RowBox[{"ReIm", "/@", "eigenVals"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prBound", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xlab", "=", 
