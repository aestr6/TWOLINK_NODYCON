Cell["\<\
Depicts period-doubling bifurcation of the brachiating gait family under \
state-based switching. Initial gaits are shown in red while the last 50 gaits \
are shown in blue. \
\>", "Text",
 CellChangeTimes->{{3.9953199565129747`*^9, 
  3.995320061089093*^9}},ExpressionUUID->"c32a73ae-1565-401d-95c7-\
25c56798ecea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"idxStart", "=", "9800"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"idxEnd", "=", "10492"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pdSubset", "=", 
    RowBox[{"StateImpacts", "[", 
     RowBox[{"[", 
      RowBox[{"idxStart", ";;", "idxEnd"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scatterData", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "1"}], "}"}]}], "]"}], "]"}], "*", 
         "radToDeg"}], ",", 
        RowBox[{"-", 
         RowBox[{"Min", "[", 
          RowBox[{"50", ",", 
           RowBox[{"Length", "[", "#", "]"}]}], "]"}]}]}], "]"}], "&"}], ",", 
     "pdSubset"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lineData", "=", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pdSubset", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "1"}], "}"}]}], "]"}], "]"}], "*", "radToDeg"}], 
      ",", "First"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotScatter", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"scatterData", ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotLine", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"lineData", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Red", ",", "Thick"}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ptPD", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"pdSubset", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "1"}], "}"}]}], "]"}], "]"}], "*", "radToDeg"}], 
     ")"}], "[", 
    RowBox[{"[", "179", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"labelPD", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{"\"\<\\\\text{PD}\>\"", ",", 
     RowBox[{"FontSize", "->", "28"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"posPD", "=", 
    RowBox[{"ptPD", "+", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "2.0"}], "}"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xlab", "=", 
   RowBox[{"MaTeX", "[", 
    RowBox[{"\"\<\\\\sigma\>\"", ",", 
     RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
