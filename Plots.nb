          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], ">=", "1"}], "&"}]}],
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
