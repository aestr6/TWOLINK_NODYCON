           RowBox[{"Length", "@", "xeq"}], "]"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"wroot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tl_", ",", " ", "tu_"}], "}"}], ",", " ", 
      RowBox[{"up_", ":", "True"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "t"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"t_", "?", "NumberQ"}], "]"}], " ", ":=", " ", 
