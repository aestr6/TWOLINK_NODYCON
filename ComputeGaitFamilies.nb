Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"beqn", "[", "q_", "]"}], " ", ":=", " ", 
    RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "var", ",", " ", "t", ",", " ", "f", ",", " ", "x0", ",", " ", "x", 
         " ", ",", " ", "\[Xi]", ",", " ", "d\[Xi]", ",", " ", "eqns", ",", 
         " ", "evnts"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"var", "[", "1", "]"}], " ", "=", " ", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", "#"}], "]"}], "[", "t", "]"}], ")"}], "&"}], 
           ",", " ", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"f", "[", "1", "]"}], " ", "=", " ", 
         RowBox[{"TwoLink`Dynamics`F", "[", 
          RowBox[{
           RowBox[{"var", "[", "1", "]"}], ",", " ", "0"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x0", " ", "=", " ", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"var", "[", "1", "]"}], "\[Equal]", " ", 
            RowBox[{"{", 
             RowBox[{"q", ",", " ", 
              RowBox[{"\[Pi]", "-", 
               RowBox[{"2", "q"}]}], ",", " ", "0", ",", " ", "0"}], "}"}]}], 
           "]"}], " ", "/.", " ", 
          RowBox[{"t", "\[Rule]", " ", "0"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"eqns", " ", "=", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"var", "[", "1", "]"}], ",", " ", "t"}], "]"}], "\[Equal]",
            " ", 
           RowBox[{"f", "[", "1", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"evnts", " ", "=", " ", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<EventLocator\>\"", ",", 
            RowBox[{"\"\<Event\>\"", "\[Rule]", "  ", 
             RowBox[{
              RowBox[{"var", "[", "1", "]"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{"\"\<EventAction\>\"", "\[RuleDelayed]", 
             RowBox[{"Throw", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"FixAngles", "[", 
                  RowBox[{
                   SubscriptBox["x", "2"], "[", "t", "]"}], "]"}], ",", " ", 
                 RowBox[{"2", " ", "t"}]}], "}"}], ",", 
               " ", "\"\<x1 = 0\>\""}], "]"}]}], ",", 
            
            RowBox[{"\"\<EventLocationMethod\>\"", 
             "\[Rule]", "\"\<Brent\>\""}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eqns", ",", " ", "x0"}], "}"}], ",", " ", 
          RowBox[{"{", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "50"}], "}"}], ",", " ", "evnts", ",", " ", 
          
          RowBox[{"StartingStepSize", "\[Rule]", "0.25"}], ",", " ", 
          RowBox[{"AccuracyGoal", "\[Rule]", " ", "12"}], ",", " ", 
          RowBox[{"PrecisionGoal", "\[Rule]", " ", "12"}], ",", " ", 
          RowBox[{"MaxSteps", "\[Rule]", " ", "Infinity"}]}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"broot", "[", 
     RowBox[{"{", 
      RowBox[{"ql_", ",", " ", "qu_"}], "}"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "q"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"q_", "?", "NumberQ"}], "]"}], " ", ":=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"NDSolve", " ", "@@", " ", 
            RowBox[{"beqn", "[", "q", "]"}]}], ",", " ", "\"\<x1 = 0\>\""}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q", " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"r", "[", "q", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q", ",", " ", "ql", ",", " ", "qu"}], "}"}]}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bc", "[", 
   RowBox[{"{", 
    RowBox[{"ql_", ",", " ", "qu_"}], "}"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q", ",", " ", "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", " ", "=", " ", 
      RowBox[{"broot", "[", 
       RowBox[{"{", 
        RowBox[{"ql", ",", " ", "qu"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Last", "@", 
       RowBox[{"Catch", "[", 
        RowBox[{
         RowBox[{"NDSolve", " ", "@@", " ", 
          RowBox[{"beqn", "[", "q", "]"}]}], ",", " ", "\"\<x1 = 0\>\""}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"\[Pi]", "-", 
        RowBox[{"2", "q"}]}], ",", " ", "0", ",", " ", "0", ",", " ", "t"}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{3.9936692219933662`*^9},
