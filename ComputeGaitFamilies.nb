   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"midIndex", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"Length", "[", "BUT", "]"}], "*", 
       RowBox[{"3", "/", "4"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cMid", "=", 
     RowBox[{"BUT", "[", 
