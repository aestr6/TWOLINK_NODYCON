     RowBox[{"{", 
      RowBox[{"0.3", ",", " ", "0.6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.6", ",", " ", "1.5"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
