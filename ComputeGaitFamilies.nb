   RowBox[{"bu", " ", "=", " ", 
    RowBox[{"bc", " ", "/@", " ", "box"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
