Cell[CellGroupData[{

Cell["Simulating time and state based impacts", "Subsection",
 CellChangeTimes->{{3.99191966285859*^9, 
  3.991919675612239*^9}},ExpressionUUID->"0b914cb8-8822-4a38-970b-\
09a53c2308df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NImpactSimulationTimeSwitching", "[", 
   RowBox[{"c_", ",", 
    RowBox[{"n_", ":", "1000"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x0", ",", "t", ",", "\[Sigma]", ",", "z", ",", "j"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x0", "=", 
      RowBox[{"c", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "4"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"t", "=", 
      RowBox[{"c", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"TwoLink`Dynamics`Slope", "[", "x0", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "+", "1"}], ",", "6"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"z", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", 
      RowBox[{"Join", "[", 
       RowBox[{"x0", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "\[Sigma]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"x0", "=", 
         RowBox[{"FixState", "@", 
          RowBox[{
           RowBox[{"H", "[", 
            RowBox[{"\[CurlyPhi]", "[", 
             RowBox[{
              RowBox[{"z", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", 
                 RowBox[{"1", ";;", "4"}]}], "]"}], "]"}], ",", 
              RowBox[{"0", "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "t"}], "}"}], ",", 
              RowBox[{"EventHandler", "->", "False"}]}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "4"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t", "=", 
         RowBox[{"timp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]", "=", 
         RowBox[{"TwoLink`Dynamics`Slope", "[", "x0", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{"Join", "[", 
          RowBox[{"x0", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "\[Sigma]"}], "}"}]}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "z"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NImpactSimulationStateSwitching", "[", 
   RowBox[{"c_", ",", 
    RowBox[{"tmax_", ":", "15"}], ",", 
    RowBox[{"n_", ":", "1000"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x0", ",", "t", ",", "\[Sigma]", ",", "z", ",", "j"}], "}"}], ",",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x0", "=", 
      RowBox[{"c", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "4"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"t", "=", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyPhi]", "[", 
          RowBox[{"x0", ",", " ", 
           RowBox[{"0", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "tmax"}], "}"}], ",", " ", 
           RowBox[{"EventHandler", "\[Rule]", " ", "True"}]}], "]"}], ";", 
         " ", 
         RowBox[{"timp", "[", "]"}]}], ",", " ", "Infinity", ",", " ", 
        RowBox[{"\[CurlyPhi]", "::", "section"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"TwoLink`Dynamics`Slope", "[", "x0", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "+", "1"}], ",", "6"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"z", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", 
      RowBox[{"Join", "[", 
       RowBox[{"x0", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "\[Sigma]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Check", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x0", "=", 
           RowBox[{"FixState", "@", 
            RowBox[{
             RowBox[{"H", "[", 
              RowBox[{"\[CurlyPhi]", "[", 
               RowBox[{
                RowBox[{"z", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", 
                   RowBox[{"1", ";;", "4"}]}], "]"}], "]"}], ",", 
                RowBox[{"0", "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "tmax"}], "}"}], ",", 
                RowBox[{"EventHandler", "->", "True"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "4"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"t", "=", 
           RowBox[{"timp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Sigma]", "=", 
           RowBox[{"TwoLink`Dynamics`Slope", "[", "x0", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"z", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"Join", "[", 
            RowBox[{"x0", ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "\[Sigma]"}], "}"}]}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"z", "[", 
            RowBox[{"[", 
             RowBox[{";;", "j"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"Break", "[", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\[CurlyPhi]", "::", "section"}]}], "\[IndentingNewLine]", 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "z"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",\

 InitializationCell->True,
