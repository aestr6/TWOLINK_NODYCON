     RowBox[{"q", " ", "=", " ", 
      RowBox[{"x", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dq", "=", " ", 
