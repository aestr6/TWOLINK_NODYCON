 InitializationCell->True],

Cell[CellGroupData[{

Cell["Continuous Dynamics", "Subsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", "q_", "]"}], ":=", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "c2", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c2", " ", "=", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"q", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      TagBox[
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"2", " ", "c2", " ", "d1"}], "+", "k1", "+", "k2"}], 
           RowBox[{
            RowBox[{"c2", " ", "d1"}], "+", "k1"}]},
          {
           RowBox[{
            RowBox[{"c2", " ", "d1"}], "+", "k1"}], "k1"}
         },
