   RowBox[{"G", "[", "q_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s1", ",", " ", "s12"}], "}"}], ",", "\[IndentingNewLine]", 
