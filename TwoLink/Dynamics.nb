              Offset[0.4]}, 
             Offset[0.2]}, "RowsIndexed" -> {}}], ")"}],
       Function[BoxForm`e$, 
        MatrixForm[BoxForm`e$]]]}]}], "\n", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", 
    RowBox[{"q_", ",", " ", "dq_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s2", ",", " ", "x3", ",", " ", "x4"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s2", " ", "=", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"q", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x3", " ", "=", " ", 
       RowBox[{"dq", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x4", "=", " ", 
       RowBox[{"dq", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
      TagBox[
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            RowBox[{"-", "d1"}], " ", "s2", " ", "x4"}], 
           RowBox[{
            RowBox[{"-", "d1"}], " ", "s2", " ", 
