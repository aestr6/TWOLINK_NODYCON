Notebook[{

Cell[CellGroupData[{
Cell["Begin Package", "Section",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{"BeginPackage", "[", "\"\<TwoLink`\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"DefaultPhysicalParameters", "::", "usage"}], " ", "=", " ", 
  "\"\<DefaultPhysicalParameters[] sets the physical parameters such as \
length and mass to those stated in the Gomes and Ruina zero-energy loss \
brachiation paper.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetPhysicalParameters", "::", "usage"}], " ", "=", " ", 
  "\"\<SetPhysicalParameters[parms] set the physical parameters associated \
with the Monkeybot.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearPhysicalParameters", "::", "usage"}], " ", "=", " ", 
   "\"\<ClearPhysicalParameters[] clears the physical parameters associated \
with the Monkeybot.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FixState", "::", "usage"}], " ", "=", " ", 
   "\"\<FixState[x] maps angles to (-pi pi]\>\""}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Begin", "[", "\"\<`Dynamics`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "::", "usage"}], "=", 
  "\"\<F[x, u] is the equations of motion for continuous contact brachiation, \
i.e., the double pendulum dynamics.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DF", "::", "usage"}], "=", 
  "\"\<DF[x, u, \[Xi], \[Mu]] is the solution to d/dt \[PartialD]x(t)/\
\[PartialD]\[Lambda] = DF(x(s), u(s)) \[PartialD]x(t)/\[PartialD]\[Lambda].\>\
\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ft", "::", "usage"}], "=", 
   "\"\<Ft[x, u, \[Tau]] = F[x, u]\[PartialD]t/\[PartialD]\[Lambda] is the \
derivative of x(t) with respect to \[Lambda] when t = t(\[Lambda]).\>\""}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"H", "::", "usage"}], "=", 
  "\"\<H[x] the discrete jump map at the time of impact.\>\""}], "\n", 
 RowBox[{
  RowBox[{"Hinv", "::", "usage"}], "=", 
  "\"\<Hinv[x] the inverse discrete jump map at the time of impact.\>\""}], "\
\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DH", "::", "usage"}], "=", 
   "\"\<DH[x] the derivative of the jump map \
\[PartialD]H(x(t))/\[PartialD]x(t).\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Energy", "::", "usage"}], " ", "=", " ", 
   "\"\<Energy[x] calculates the amount of energy in the system.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Slope", "::", "usage"}], " ", "=", " ", 
  "\"\<slope[x] calculates the slope the two links form with the \
horizontal.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "::", "usage"}], " ", "=", " ", 
  "\"\<S[x, x0] computes the Poincare map for zero slope crossings such that \
slope[x] - slope[x0] = 0.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DS", "::", "usage"}], " ", "=", " ", 
  "\"\<DS[x, x0] computes the time derivative of the Poincare section.  This \
version of the function can't be built with Compile because of the \
conditional statements in FixAngles.  Changes here will not be reflected in \
its compiled version.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ValidCrossing", "::", "usage"}], " ", "=", " ", 
  "\"\<ValidCrossing[x, x0] returns true if the section S is crossed in the \
correct direction.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtd\[Lambda]", "::", "usage"}], " ", "=", " ", 
   "\"\<dtd\[Lambda][s, x\[Xi], x\[Xi]0] is the derivative of the final \
switching time with respect to the controls at the section S.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FixAngles", "::", "usage"}], " ", "=", " ", 
  "\"\<FixAngles[q] maps angles to (-pi pi]\>\""}]}], "Input",
 InitializationCell->True]
}, Open  ]],

