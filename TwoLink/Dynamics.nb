     "\[IndentingNewLine]", 
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k1", " ", "=", " ", "0.276829359066204"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k2", " ", "=", " ", "8.842649843207664"}], ";", 
     "\[IndentingNewLine]", 
