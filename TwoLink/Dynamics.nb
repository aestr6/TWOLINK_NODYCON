Cell[CellGroupData[{

Cell["Impact Dynamics !!!not general, assumes d1 = d2!!!", "Subsection",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"not", " ", "general"}], ",", " ", 
    RowBox[{
     RowBox[{"assumes", " ", "d1"}], " ", "=", " ", "d2"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"P", "[", "q_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c2", ",", " ", "z1", ",", " ", "z2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c2", " ", "=", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"q", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z1", " ", "=", " ", 
       RowBox[{
        RowBox[{"2", " ", "b", " ", "d1", " ", "k1"}], "-", 
        RowBox[{"2", "k1", " ", "k2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z2", " ", "=", " ", 
       RowBox[{
        RowBox[{"d1", "^", "2"}], "-", 
        RowBox[{"2", "k1", " ", "k2"}], "+", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", 
           RowBox[{"q", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       FractionBox["1", "z2"], 
       TagBox[
        RowBox[{" ", 
         RowBox[{"(", GridBox[{
            {
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", "c2", " ", "d1", " ", 
               RowBox[{"(", 
                RowBox[{"d1", "-", 
                 RowBox[{"b", " ", "k1"}]}], ")"}]}], "+", "z1"}], "z1"},
            {
             RowBox[{
              RowBox[{"-", "4"}], " ", "d1", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "b"}], ")"}], " ", "c2", " ", 
                 "d1"}], "+", 
                RowBox[{"b", " ", "k1"}], "-", "k2"}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                FractionBox[
                 RowBox[{"q", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "2"], "]"}], "2"]}], 
             RowBox[{
              RowBox[{"2", " ", "c2", " ", "d1", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "b"}], " ", "d1"}], "+", "k2"}], ")"}]}], "-", 
              "z1"}]}
           },
           
           GridBoxAlignment->{
            "Columns" -> {{Center}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.7]}, 
               Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}, "RowsIndexed" -> {}}], ")"}]}],
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]}]}]}], "\n", "]"}]}]}]], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Jump Map", "Subsection",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
