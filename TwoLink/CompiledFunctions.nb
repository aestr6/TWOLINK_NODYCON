Cell[CellGroupData[{
Cell["Begin Package", "Section",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<TwoLink`\>\"", "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"functions", " ", "defined", " ", "in", " ", "Dynamics"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"F", "::", "usage"}], "=", 
  "\"\<F[x\[Xi], u, \[Mu]] is the compiled function of Dynamics`F and \
Dynamics`DF, where x\[Xi] is the flow of the combined equations d/dt (x(t), \
\[Xi](t) = (F(x, u), DF(x, u)\[Xi])\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ft", "::", "usage"}], "=", 
   "\"\<Ft[x\[Xi], u, \[Tau]] is the compiled function of Dynamics`Ftf, where \
x\[Xi] is the flow of the combined equations d/dt (x(t), \[Xi](t) = (F(x, u), \
DF(x, u)\[Xi])\>\""}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"H", "::", "usage"}], "=", 
  "\"\<H[x\[Xi]] is the compiled function of Dynamics`H and the product \
Dynamics`DH.\[Xi], where x\[Xi] is the flow of the combined equations d/dt \
(x(t), \[Xi](t) = (F(x, u), DF(x, u)\[Xi])\>\""}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Hinv", "::", "usage"}], "=", 
   "\"\<Hinv[x\[Xi]] is the compiled function of the inverse discrete jump \
map at the time of impact.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Energy", "::", "usage"}], " ", "=", " ", 
   "\"\<Energy[x] calculates the amount of energy in the system.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Slope", "::", "usage"}], " ", "=", " ", 
  "\"\<slope[x] calculates the slope the two links form with the \
horizontal.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "::", "usage"}], " ", "=", " ", 
  "\"\<S[x, x0] computes the Poincare map for zero slope crossings such that \
slope[x] - slope[x0] = 0.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DS", "::", "usage"}], " ", "=", " ", 
  "\"\<DS[x, x0] computes the time derivative of the Poincare \
section.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ValidCrossing", "::", "usage"}], " ", "=", " ", 
  "\"\<ValidCrossing[x, x0] returns true if the section S is crossed in the \
correct direction.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtd\[Lambda]", "::", "usage"}], " ", "=", " ", 
   "\"\<dtd\[Lambda][s, x\[Xi], x\[Xi]0] is the derivative of the final \
switching time with respect to the controls at the section S.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FixAngles", "::", "usage"}], " ", "=", " ", 
   "\"\<FixAngles[q] maps angles to (-pi pi]\>\""}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"functions", " ", "defined", " ", "in", " ", "CompiledFunctions"}],
    " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CurlyPhi]", "::", "usage"}], " ", "=", " ", 
   "\"\<\[CurlyPhi][x\[Xi]0, u, t, \[Mu], \[Tau]] returns the flow of the \
combined equations d/dt (x(t), \[Xi](t) = (F(x, u), DF(x, u)\[Xi]) based on \
functions that depend on the parameters in \[Lambda] as returned from the \
output of a call to CreateControls.  A shortened version, \[CurlyPhi][x0, u, \
t] is also available, but does not compute the derivative \[Xi] \
correctly.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"timp", "::", "usage"}], " ", "=", " ", 
   "\"\<timp[] returns the impact time of the last call to \
\[CurlyPhi].\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CompileFunctions", "::", "usage"}], " ", "=", " ", 
   "\"\<CompileFunctions[] creates compiled versions of numerous functions, \
such as F, DF, Ft, H, Hinv, and DH based on |\[Lambda]| = n.  The default \
value for n is 6 for \[Lambda] = (x0, t, u).\>\""}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Begin", "[", "\"\<`CompiledFunctions`\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Needs", "[", 
    "\"\<DifferentialEquations`InterpolatingFunctionAnatomy`\>\"", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", " ", "=", " ", "6"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"|", "\[Lambda]", "|", " ", 
     RowBox[{"for", " ", "\[Lambda]"}]}], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{"x0", ",", " ", "t", ",", " ", "u"}], ")"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"n", ",", 
     RowBox[{"{", 
      RowBox[{"Protected", ",", "Locked"}], "}"}]}], "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"\[CurlyPhi]", " ", 
    RowBox[{"isn", "'"}], "t", " ", "100", "%", " ", "general", " ", "so", 
    " ", "lock", " ", "n", " ", "for", " ", "now"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timpact", ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"records", " ", "the", " ", "impact", " ", "time"}], ",", " ", 
    RowBox[{
    "changes", " ", "with", " ", "every", " ", "call", " ", "to", " ", 
     "\[CurlyPhi]"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cf", ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "an", " ", "associative", " ", "array", " ", "of", " ", "compiled", " ", 
    "functions"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x\[Xi]0flow", ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "initial", " ", "condition", " ", "used", " ", "in", " ", "shortened", " ",
     "version", " ", "of", " ", "Flow"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zfun", ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "zero", " ", "function", " ", "used", " ", "in", " ", 
    "shortened", " ", "version", " ", "of", " ", "Flow"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "update", " ", "variables", " ", "for", " ", "shortened", " ", "version", 
    " ", "of", " ", "Flow"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x\[Xi]0flow", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zfun", " ", "=", " ", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", "n"}], "]"}], "]"}], "&"}]}], ";"}]}], "Input",
 InitializationCell->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compiled derivatives for x(t) and \[Xi](t) = \[PartialD]x(t)/\[PartialD]\
\[Lambda]\
\>", "Section",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CompileFunctions", "[", "]"}], " ", ":=", " ", "\n", 
