         RowBox[{"ns", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          ".", 
         RowBox[{
          RowBox[{
          "ns", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
          "\[Transpose]"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
