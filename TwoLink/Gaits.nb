Cell[CellGroupData[{
Cell["Begin Package", "Section",
 InitializationCell->
  True,ExpressionUUID->"0dd384d7-a213-7246-938d-a50dc6f26fb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<TwoLink`\>\"", "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlmap", "::", "usage"}], " ", "=", " ", 
   "\"\<tlmap[x0, u, t] integrates from x0 to x(t) with constant torque \
u.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlroot", "::", "usage"}], " ", "=", " ", 
   "\"\<tlroot[f] sets the implicit function for tlc0 and tlc when generating \
points on the curve defined by f[\[Lambda]] = 0.  If it is a custom function, \
then it must be of the form f[\[Lambda]] and must return a list containing \
values for f,  its derivative df/d\[Lambda], and the eigenvalues of \
dH(x(t))/dx0.  There are string values of f that will return a predefined \
implicit function.  The string values for type are: \npt --passive time-based \
roots\nat --actuated time-based roots\npe --passive event-based roots\nae \
--actuated event-based roots\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlc0", "::", "usage"}], " ", "=", " ", 
   "\"\<tlc0[\[Lambda], h] returns the initial list that should be passed to \
the function tlc when generating the solution curve of f (set by \
tlroot).\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlc", "::", "usage"}], " ", "=", " ", 
   "\"\<tlc[c0] returns the next point, c1, on the curve of roots belonging \
to f (set by tlroot).\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlac", "::", "usage"}], " ", "=", " ", 
   "\"\<tlac[c0] returns the next point, c1, on the curve of roots belonging \
to f (set by tlroot) using an adaptive step length.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tle", "::", "usage"}], " ", "=", " ", 
   "\"\<tle[c0] calculates the next point, c1, on the 1-D curve of points \
that are roots of f (set by tlroot) using an embedding algorithm.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlcurve", "::", "usage"}], " ", "=", " ", 
   "\"\<tlcurve[name, c, \[Lambda], h, m] using method c calculates a 1D \
curve of m points that are roots of f (set by tlroot) starting with the root \
at (x0, T) with a step size of h.  name is an arbitrary tag associated with \
the function call.  Any of the curve functions, tlc, tlac, or tle are valid \
for c.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tlparcurve", "::", "usage"}], " ", "=", " ", 
   "\"\<tlparcurve[name, c, \[Lambda], h, m] using method c calculates a 1D \
curve of m points that are roots of f (set by tlroot) starting with the root \
at (x0, t) in parallel by taking step sizes that are multiples of 2 (in the \
future this should be the number of cores in the system).  name is an \
arbitrary tag associated with the function call.  Any of the curve functions, \
tlc, tlac, or tle are valid for c.  The parallel environment has to be setup \
appropriately, e.g., ParallelNeeds[\\\"TwoLinks`\\\"], for this function to \
work.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Begin", "[", "\"\<`Gaits`\>\"", "]"}]}], "Input",
 InitializationCell->
  True,ExpressionUUID->"69fbd5c3-6a1d-aa4d-ab33-0e410fd1c7ae"]
}, Open  ]],

