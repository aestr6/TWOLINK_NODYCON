      "Based", " ", "on", " ", "Numerical", " ", "Continuation", " ", 
       "Methods"}], ",", " ", 
      RowBox[{"Allgower", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kder", ",", " ", "dder", ",", " ", "ader"}], "}"}], " ", "=", 
      " ", 
      RowBox[{"OptionValue", "[", "\"\<ders\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
