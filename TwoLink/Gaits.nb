          RowBox[{
           RowBox[{"NS", ".", 
            RowBox[{"(", 
             RowBox[{"Z", "-", "Y"}], ")"}]}], " ", "-", " ", "h"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{
          "dg", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
