      RowBox[{"Y", " ", "+", 
       RowBox[{"h", " ", "NS"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "g", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           " ", 
           RowBox[{
           "dg", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           " ", "eig"}], "}"}], " ", "=", "  ", 
         RowBox[{"f", "[", 
          RowBox[{"Z", ",", " ", "opts"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ns", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
