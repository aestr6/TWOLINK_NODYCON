        "\[IndentingNewLine]", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "step", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", "=", "  ", 
           RowBox[{
            RowBox[{"Inverse", "[", 
             RowBox[{
             "dg", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
