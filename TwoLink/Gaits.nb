        RowBox[{"a", "/", "ader"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", " ", 
        RowBox[{
        "\"\< k \>\"", ",", "k", ",", "  ", "\"\< d \>\"", ",", "d", ",", 
         "  ", "\"\< a \>\"", ",", 
