       RowBox[{"Norm", "[", 
        RowBox[{"H", ".", 
         RowBox[{
         "g", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "]"}],
        " ", "/", " ", 
       RowBox[{"Norm", "[", 
        RowBox[{"H", ".", 
         RowBox[{
         "g", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", " ", "=", " ", 
