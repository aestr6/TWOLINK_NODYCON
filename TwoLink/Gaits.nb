   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "g", ",", " ", "dg", ",", " ", "Z", ",", " ", "step", ",", " ", "ns", 
      ",", " ", "H", ",", " ", "k", ",", " ", "d", ",", " ", "a", ",", " ", 
      "eig", ",", " ", "kder", ",", " ", "dder", ",", " ", "ader"}], "}"}], 
