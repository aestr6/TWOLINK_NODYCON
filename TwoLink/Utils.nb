Cell[CellGroupData[{
Cell["Begin Package", "Section",
 InitializationCell->
  True,ExpressionUUID->"21fb1161-b709-8742-9882-9236b358f663"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<TwoLink`\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Anim", "::", "usage"}], " ", "=", " ", 
  "\"\<Anim[x0, u, t] animates the swing motion defined by the initial \
condition x0, switching time t, and torque u.\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Draw", "::", "usage"}], " ", "=", " ", 
   "\"\<Draw[x] returns a picture of the robot's configuration.  If the \
optional value \\\"fg\\\" is true, then a thick border is added to the links, \
otherwise the border of the links is a light gray.  Draw[x0, u, t, n] returns \
a motion blur of the swing motion for the initial conition x0 with timesteps \
of t/n.\>\""}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrameTickLabel", "::", "usage"}], " ", "=", " ", 
   "\"\<FrameTickLabel[plot, f] draws a frame around a plot and replaces  the \
default tickmark with a label defined by the function f on the ordinate axis. \
 By default the ordinate is plotted with the degree symbol.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FixSlopeAngles", "::", "usage"}], " ", "=", " ", 
   "\"\<FixSlopAngles[\[Sigma]] maps slope angles to (-pi/2 pi/2].\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FixParameters", "::", "usage"}], " ", "=", " ", 
   "\"\<FixParameters[c] applies FixAngles and FixSlopeAngles.\>\""}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Begin", "[", "\"\<`Utils`\>\"", "]"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9921038368837337`*^9, 3.992103909382223*^9}, {
  3.992103939386539*^9, 3.9921039904041343`*^9}, {3.9921057674250927`*^9, 
  3.992105768298874*^9}},ExpressionUUID->"727c1c6c-cdbc-7d48-99a0-\
b358c6538d83"]
}, Open  ]],

