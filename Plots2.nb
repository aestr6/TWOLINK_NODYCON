 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"ValueQ", "[", "Z", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Z", " ", "=", " ", 
       RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"tmax", " ", "=", " ", 
           RowBox[{"75", " ", "15"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"n", " ", "=", " ", "1000"}], ";", "\[IndentingNewLine]", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"{", 
              RowBox[{"n", ",", " ", "6"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"x0", " ", "=", " ", 
           RowBox[{"c", "\[LeftDoubleBracket]", 
            RowBox[{"1", ";;", "4"}], "\[RightDoubleBracket]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"xt", " ", "=", " ", 
              RowBox[{"Catch", "[", 
               RowBox[{"Quiet", "@", 
                RowBox[{"\[CurlyPhi]", "[", 
                 RowBox[{"x0", ",", " ", 
                  RowBox[{"0", "&"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", " ", "tmax"}], "}"}], ",", " ", 
                  RowBox[{"EventHandler", "\[Rule]", " ", "True"}], ",", " ", 
                  RowBox[{"Cross", " ", "->", " ", "True"}]}], "]"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"t", " ", "=", " ", 
              RowBox[{"timp", "[", "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"\[Sigma]", " ", "=", " ", 
              RowBox[{"TwoLink`Dynamics`Slope", "[", "x0", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "z", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
              " ", "=", " ", 
              RowBox[{"Join", "[", 
               RowBox[{"x0", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"t", ",", " ", "\[Sigma]"}], "}"}]}], "]"}]}], ";", 
