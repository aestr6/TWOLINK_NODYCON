            ",", " ", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "n"}], "}"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", "z"}], ",", 
         "\[IndentingNewLine]", 
