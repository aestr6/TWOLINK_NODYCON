        RowBox[{"#", " ", "-", " ", "0.5"}], ",", " ", 
        RowBox[{"#", " ", "+", " ", "0.5"}]}], "}"}]}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
